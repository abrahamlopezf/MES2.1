# =====================================
# PLANTILLA DE AMBIENTE PRODUCCIÓN (OPERACIÓN INDUSTRIAL REAL)
# Configurar únicamente en el gestor de secretos del servidor productivo.
# =====================================
APP_ENV=production
NODE_ENV=production
PORT=4000

TZ=America/Mexico_City
TIMEZONE=America/Mexico_City
TIMEZONE_STANDARD_CODE=CST
UTC_OFFSET=-06:00

CLIENT_URL=https://mes.interplas.example.com

# Cadena de conexión exclusiva del clúster PostgreSQL de Producción
DATABASE_URL=

# Secretos criptográficos exclusivos de Producción (>= 32 bytes)
JWT_SECRET=
JWT_EXPIRES_IN=12h
QR_ENCRYPTION_KEY=

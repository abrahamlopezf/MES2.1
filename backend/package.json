{
  "name": "Demo-Backend",
  "version": "1.0.0",
  "description": "TraceFlow MES Backend API",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "dev:check": "node src/scripts/dev-check.js",
    "security:check": "node src/scripts/security-check.js",
    "test:unit": "node --test test/envIsolationGuard.test.js test/characterization.contracts.test.js test/formulaMachinePolicy.test.js test/qr.traceability-tree.test.js test/queueOutputSnapshot.test.js test/siloConsumptionAllocator.test.js test/telares-shift-timezone.test.js test/telares.production-rules.test.js test/telares.rules.test.js src/database/tests/*.test.js src/modules/extrusion/services/*.test.js src/modules/warehouse/*.test.js",
    "test:integration": "node src/scripts/run-local-integration.js",
    "test:integrity": "node src/scripts/master-data-fingerprint.js",
    "db:backup:local": "node src/scripts/local-db-backup.js",
    "db:verify:local": "node src/scripts/validate-migration.js",
    "db:verify:privileges": "node src/scripts/verify-local-db-privileges.js",
    "validate": "node src/scripts/security-check.js && node --test test/envIsolationGuard.test.js test/characterization.contracts.test.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:one": "sequelize-cli db:seed",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "db:seed:catalog": "sequelize-cli db:seed --seed 20260826120000-production-catalog-data.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "html5-qrcode": "^2.3.8",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "sequelize": "^6.37.8",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "eslint": "^10.5.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.4",
    "sequelize-cli": "^6.6.5"
  }
}

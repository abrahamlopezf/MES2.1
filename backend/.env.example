# =====================================
# APP
# =====================================

NODE_ENV=development
PORT=4000

# =====================================
# ZONA HORARIA CDMX (CST / UTC-6)
# =====================================
TZ=America/Mexico_City
TIMEZONE=America/Mexico_City
TIMEZONE_STANDARD_CODE=CST
UTC_OFFSET=-06:00

# Frontend permitido (se pueden separar varios por coma)
CLIENT_URL=http://localhost:5173

# =====================================
# BASE DE DATOS (LOCAL)
# =====================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# =====================================
# BASE DE DATOS (PRODUCCIÓN)
# =====================================

DATABASE_URL=

# Scripts manuales de diagnóstico/sincronización; no agregues sus valores a Git.
REMOTE_DATABASE_URL=
LOCAL_DB_PASSWORD=
TEST_ACCOUNT_PASSWORD=
TEST_ACCOUNT_USERNAME=
QA_API_BASE=http://localhost:4000/api
ALLOW_REMOTE_SYNC=
ALLOW_REMOTE_SCHEMA_FIX=
ALLOW_PRODUCTION_SECURITY_TESTS=

# =====================================
# JWT
# =====================================

JWT_SECRET=
JWT_EXPIRES_IN=12h

# Clave independiente para QR nuevos (se recomienda un secreto aleatorio >= 32 caracteres).
QR_ENCRYPTION_KEY=

# Solo para UAT con QRs legados AES-CBC; omitir en una Producción nueva y limpia.
QR_LEGACY_DECRYPTION_KEY=

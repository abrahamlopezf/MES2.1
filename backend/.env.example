# =====================================
# PERFIL DE AMBIENTE E INFRAESTRUCTURA
# Valores permitidos: local | test | uat | production
# =====================================
APP_ENV=local
NODE_ENV=development
PORT=4000

# =====================================
# ZONA HORARIA CDMX (CST / UTC-6)
# =====================================
TZ=America/Mexico_City
TIMEZONE=America/Mexico_City
TIMEZONE_STANDARD_CODE=CST
UTC_OFFSET=-06:00

# Frontend permitido (se pueden separar varios por coma)
CLIENT_URL=http://localhost:5173

# =====================================
# BASE DE DATOS (LOCAL — DESARROLLO)
# =====================================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sistema_enterprise
DB_TEST_NAME=sistema_enterprise_test
DB_USER=traceflow_app_local
DB_PASSWORD=REPLACE_WITH_LOCAL_DEV_APP_PASSWORD
DB_TEST_USER=traceflow_app_test
DB_TEST_PASSWORD=REPLACE_WITH_LOCAL_QA_APP_PASSWORD

# Cuentas de migración: se mantienen en backend/.env.migrator.local (ignorado por Git)
# y solo las consume Sequelize CLI; nunca se cargan en el servidor de aplicación.

# =====================================
# BASE DE DATOS REMOTA (UAT / PRODUCCIÓN)
# IMPORTANTE: En APP_ENV=local o APP_ENV=test estas variables
# DEBEN permanecer vacías. El guardián dbGuard bloqueará el arranque
# si detecta cualquier host remoto en un ambiente local.
# =====================================
DATABASE_URL=
REMOTE_DATABASE_URL=

# =====================================
# VARIABLES PARA PRUEBAS LOCALES Y QA
# =====================================
QA_API_BASE=http://127.0.0.1:4000/api
TEST_ACCOUNT_USERNAME=
TEST_ACCOUNT_PASSWORD=
E2E_TEST_PASSWORD=

# =====================================
# JWT Y SEGURIDAD QR
# =====================================
JWT_SECRET=
JWT_EXPIRES_IN=12h
QR_ENCRYPTION_KEY=
QR_LEGACY_DECRYPTION_KEY=

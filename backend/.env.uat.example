# =====================================
# PLANTILLA DE AMBIENTE UAT (USER ACCEPTANCE TESTING — CLOUD)
# No activar ni aprovisionar con datos de producción en local.
# =====================================
APP_ENV=uat
NODE_ENV=production
PORT=4000

TZ=America/Mexico_City
TIMEZONE=America/Mexico_City
TIMEZONE_STANDARD_CODE=CST
UTC_OFFSET=-06:00

CLIENT_URL=https://uat-mes.interplas.example.com

# Cadena de conexión exclusiva de la instancia PostgreSQL de UAT
DATABASE_URL=

# Secretos exclusivos de UAT (>= 32 bytes)
JWT_SECRET=
JWT_EXPIRES_IN=12h
QR_ENCRYPTION_KEY=
QR_LEGACY_DECRYPTION_KEY=

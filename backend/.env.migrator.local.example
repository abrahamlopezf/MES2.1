# Copiar localmente a .env.migrator.local. Nunca guardar credenciales reales en Git.
TRACEFLOW_DEV_MIGRATOR_USER=traceflow_dev_migrator
TRACEFLOW_DEV_MIGRATOR_PASSWORD=REPLACE_WITH_LOCAL_DEV_MIGRATOR_PASSWORD
TRACEFLOW_QA_MIGRATOR_USER=traceflow_qa_migrator
TRACEFLOW_QA_MIGRATOR_PASSWORD=REPLACE_WITH_LOCAL_QA_MIGRATOR_PASSWORD

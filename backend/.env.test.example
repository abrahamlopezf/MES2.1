# =====================================
# PLANTILLA DE AMBIENTE DE PRUEBAS QA / INTEGRACIÓN LOCAL
# =====================================
APP_ENV=test
NODE_ENV=test
PORT=4001

TZ=America/Mexico_City
TIMEZONE=America/Mexico_City
TIMEZONE_STANDARD_CODE=CST
UTC_OFFSET=-06:00

CLIENT_URL=http://127.0.0.1:5174

# Base de datos local aislada exclusivamente para pruebas y QA
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sistema_enterprise_test
DB_TEST_NAME=sistema_enterprise_test
DB_TEST_USER=traceflow_app_test
DB_TEST_PASSWORD=REPLACE_WITH_LOCAL_QA_APP_PASSWORD

# Prohibido definir URLs remotas en pruebas
DATABASE_URL=
REMOTE_DATABASE_URL=

JWT_SECRET=test_only_local_jwt_secret_key_32_bytes_min
JWT_EXPIRES_IN=4h
QR_ENCRYPTION_KEY=

{
  "name": "traceflow-mes-workspace",
  "private": true,
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:check": "npm --prefix backend run dev:check",
    "security:check": "npm --prefix backend run security:check",
    "test:unit": "npm --prefix backend run test:unit",
    "test:frontend": "npm --prefix frontend run test -- --run",
    "test:integration": "npm --prefix backend run test:integration",
    "test:integrity": "npm --prefix backend run test:integrity",
    "db:backup:local": "npm --prefix backend run db:backup:local",
    "db:verify:local": "npm --prefix backend run db:verify:local",
    "validate": "npm --prefix backend run validate && npm --prefix frontend run build"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.23",
    "@playwright/test": "^1.64.1"
  }
}
